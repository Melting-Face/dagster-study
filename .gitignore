.venv/
data/          # 로컬 원천 덤프(csv.gz) — scripts/upload_raw_to_seaweedfs.py 입력
logs/
minio/
rustfs/
seaweedfs/
ollma/
postgres/
shared/

**/__pycache__/
.ruff_cache/
.mypy_cache/
**/*.log
**/*.duckdb
**/secrets.toml

.env
.user.yml
.DS_Store

# 트렁크 미사용 (혹시 로컬에서 trunk init 시 추적 방지)
.trunk/

# k8s values (로컬 전용)
values.yaml

# Terraform — state·크리덴셜·plan은 커밋 금지 (lock 파일은 재현성 위해 추적)
**/.terraform/
**/*.tfstate
**/*.tfstate.*
**/*.tfvars
!**/*.tfvars.example
*.tfplan
crash.log
# 회수한 클러스터 kubeconfig(공인 IP·토큰 포함)
kubeconfig-oci
