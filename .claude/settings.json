{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "ask": [
      "Bash(docker compose down * -v*)",
      "Bash(docker compose down -v*)",
      "Bash(docker compose down * --volumes*)",
      "Bash(podman compose down * -v*)",
      "Bash(podman compose down -v*)",
      "Bash(docker-compose down * -v*)",
      "Bash(scripts/k8s-down.sh*)",
      "Bash(./scripts/k8s-down.sh*)",
      "Bash(bash scripts/k8s-down.sh*)",
      "Bash(*dbt* --full-refresh*)",
      "Bash(*dbt* run-operation*)",
      "Bash(*dbt* build --full-refresh*)",
      "Bash(*dbt* seed*)",
      "Bash(*dg asset wipe*)",
      "Bash(*trino*DROP*)",
      "Bash(*trino*TRUNCATE*)",
      "Bash(*trino*DELETE*)",
      "Bash(*psql*DROP*)",
      "Bash(*psql*TRUNCATE*)",
      "Bash(*trino*drop *)",
      "Bash(*trino*truncate *)",
      "Bash(*trino*delete *)",
      "Bash(*psql*drop *)",
      "Bash(*psql*truncate *)",
      "Bash(*psql*delete *)",
      "Bash(*iceberg_maintenance_job*)",
      "Bash(*expire_iceberg_snapshots*)",
      "Bash(*remove_iceberg_orphan_files*)",
      "Bash(*optimize_iceberg_files*)",
      "Bash(*expire_snapshots*)",
      "Bash(*remove_orphan_files*)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(terraform/**/*.tfstate*)",
      "Edit(.claude/settings.json)",
      "Edit(.claude/settings.local.json)",
      "Bash(*psql*DELETE*)",
      "Edit(skills-lock.json)",
      "Edit(.claude/agents/**)",
      "Edit(**/.claude/skills/**)",
      "Edit(**/.agents/skills/**)",
      "Bash(git clone*)",
      "Bash(gh repo clone*)",
      "Bash(npm install*)",
      "Bash(npx *)",
      "Bash(uvx *)",
      "Bash(pip install*)",
      "Bash(uv pip install*)",
      "Bash(curl * -o *)",
      "Bash(wget *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/journal_guard.py session-start",
            "statusMessage": "저널 번호·열린 미션 확인",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/journal_guard.py pre-write",
            "statusMessage": "저널 넘버링 규약 검사",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/protected_paths_guard.py",
            "statusMessage": "보호 경로 쓰기 검사",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/session_sync_guard.py bash-pre",
            "statusMessage": "워킹트리 전역 변경 검사",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/session_sync_guard.py agent-pre",
            "statusMessage": "서브에이전트 중복 호출 검사",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/session_sync_guard.py file-pre",
            "statusMessage": "동일 파일 동시편집 검사",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/session_sync_guard.py agent-post",
            "statusMessage": "서브에이전트 결과 공유 기록",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/session_sync_guard.py file-post",
            "statusMessage": "파일 리스 갱신",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/session_sync_guard.py session-end",
            "statusMessage": "세션 점유 해제",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/journal_guard.py stop",
            "statusMessage": "저널 기록 누락 점검",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
